<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app"
    android:orientation="vertical">

    <include layout="@layout/view_topbar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="116dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <ImageButton
                    android:id="@+id/backToWellnessButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_menu_revert"
                    android:tint="@color/mood_cyan"
                    android:contentDescription="Back" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="sans-serif-black"
                    android:text="PREFERENCES"
                    android:textColor="@color/mood_text"
                    android:textSize="32sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Preferred Language -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Preferred Language"
                android:textColor="@color/mood_cyan"
                android:textSize="14sp"
                android:textStyle="bold" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupLanguage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">
                
                <com.google.android.material.chip.Chip style="@style/CustomChipStyle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="English" />
                <com.google.android.material.chip.Chip style="@style/CustomChipStyle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Kannada" />
                <com.google.android.material.chip.Chip style="@style/CustomChipStyle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Hindi" />
                <com.google.android.material.chip.Chip style="@style/CustomChipStyle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tamil" />
                <com.google.android.material.chip.Chip style="@style/CustomChipStyle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Telugu" />
                <com.google.android.material.chip.Chip style="@style/CustomChipStyle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Malayalam" />
                <com.google.android.material.chip.Chip style="@style/CustomChipStyle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Punjabi" />
                <com.google.android.material.chip.Chip style="@style/CustomChipStyle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Japanese" />
                <com.google.android.material.chip.Chip style="@style/CustomChipStyle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Korean" />
                <com.google.android.material.chip.Chip style="@style/CustomChipStyle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="French" />
                <com.google.android.material.chip.Chip style="@style/CustomChipStyle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Other" />
            </com.google.android.material.chip.ChipGroup>

            <EditText
                android:id="@+id/editLanguage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/glass_panel"
                android:hint="Type preferred language..."
                android:padding="12dp"
                android:textColor="@color/mood_text"
                android:textColorHint="#88AAB7C8"
                android:textSize="14sp"
                android:visibility="gone" />

            <!-- Preferred Genres -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Preferred Genres"
                android:textColor="@color/mood_cyan"
                android:textSize="14sp"
                android:textStyle="bold" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupGenres"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <com.google.android.material.chip.Chip style="@style/CustomChipStyle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Lo-Fi" />
                <com.google.android.material.chip.Chip style="@style/CustomChipStyle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Pop" />
                <com.google.android.material.chip.Chip style="@style/CustomChipStyle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Rock" />
                <com.google.android.material.chip.Chip style="@style/CustomChipStyle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="EDM" />
                <com.google.android.material.chip.Chip style="@style/CustomChipStyle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Hip-Hop" />
                <com.google.android.material.chip.Chip style="@style/CustomChipStyle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="R&amp;B" />
                <com.google.android.material.chip.Chip style="@style/CustomChipStyle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Classical" />
                <com.google.android.material.chip.Chip style="@style/CustomChipStyle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Jazz" />
                <com.google.android.material.chip.Chip style="@style/CustomChipStyle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Instrumental" />
                <com.google.android.material.chip.Chip style="@style/CustomChipStyle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Meditation" />
                <com.google.android.material.chip.Chip style="@style/CustomChipStyle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Workout" />
                <com.google.android.material.chip.Chip style="@style/CustomChipStyle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Other" />
            </com.google.android.material.chip.ChipGroup>

            <EditText
                android:id="@+id/editGenres"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/glass_panel"
                android:hint="Type custom genres..."
                android:padding="12dp"
                android:textColor="@color/mood_text"
                android:textColorHint="#88AAB7C8"
                android:textSize="14sp"
                android:visibility="gone" />

            <!-- Favorite Artists -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Favorite Artists"
                android:textColor="@color/mood_cyan"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/editArtists"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/glass_panel"
                android:hint="e.g., The Weeknd, Lofi Girl"
                android:padding="12dp"
                android:textColor="@color/mood_text"
                android:textColorHint="#88AAB7C8"
                android:textSize="14sp" />

            <!-- Music Type -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Music Type"
                android:textColor="@color/mood_cyan"
                android:textSize="14sp"
                android:textStyle="bold" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupMusicType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <com.google.android.material.chip.Chip style="@style/CustomChipStyle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Relaxation" />
                <com.google.android.material.chip.Chip style="@style/CustomChipStyle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Study" />
                <com.google.android.material.chip.Chip style="@style/CustomChipStyle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Focus" />
                <com.google.android.material.chip.Chip style="@style/CustomChipStyle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Workout" />
                <com.google.android.material.chip.Chip style="@style/CustomChipStyle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sleep" />
                <com.google.android.material.chip.Chip style="@style/CustomChipStyle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Travel" />
                <com.google.android.material.chip.Chip style="@style/CustomChipStyle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Party" />
                <com.google.android.material.chip.Chip style="@style/CustomChipStyle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Meditation" />
                <com.google.android.material.chip.Chip style="@style/CustomChipStyle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Other" />
            </com.google.android.material.chip.ChipGroup>

            <EditText
                android:id="@+id/editMusicType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/glass_panel"
                android:hint="Type custom music type..."
                android:padding="12dp"
                android:textColor="@color/mood_text"
                android:textColorHint="#88AAB7C8"
                android:textSize="14sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/saveSettingsButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="32dp"
                android:background="@drawable/chip_bg"
                android:text="Save Preferences"
                android:textAllCaps="false"
                android:textColor="@color/mood_cyan"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
