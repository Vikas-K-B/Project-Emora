<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app"
    android:orientation="vertical">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="86dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="24dp">

        <ImageButton
            android:id="@+id/backFromPrivacyBtn"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back"
            android:tint="@color/mood_cyan" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:fontFamily="sans-serif-black"
            android:text="PRIVACY POLICY"
            android:textColor="@color/mood_text"
            android:textSize="22sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Data &amp; Privacy"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp" />
                
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Your health data is extremely sensitive. This is how we handle your data in Emora:\n\n1. AI Mood Processing\nAll data is processed strictly locally on your device. When we predict your mood, your biometric data is run through an on-device TensorFlow Lite model. Your raw heart rate data is never sent to our servers.\n\n2. Health Connect\nIf you choose to enable Health Connect, we request read-only access to your historical heart rate and step count. We use this exclusively to establish your baseline vitals to provide more accurate mood tracking.\n\n3. Third Parties\nWe do not sell, rent, or trade any of your health or music preferences to third parties."
                android:textColor="@color/mood_text"
                android:textSize="16sp"
                android:lineSpacingExtra="6dp"
                android:layout_marginBottom="32dp" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
