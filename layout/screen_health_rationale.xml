<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="28dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="90dp"
            android:fontFamily="sans-serif-black"
            android:lineSpacingExtra="2dp"
            android:text="@string/health_connect_privacy_title"
            android:textColor="@color/mood_text"
            android:textSize="38sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:lineSpacingExtra="6dp"
            android:text="@string/health_connect_privacy_body"
            android:textColor="@color/mood_text"
            android:textSize="18sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="@drawable/glass_panel"
            android:lineSpacingExtra="4dp"
            android:padding="22dp"
            android:text="Permissions requested:\n\nHeart rate: show real BPM and mood trend.\nSteps: calculate daily activity context for the wellness score."
            android:textColor="@color/mood_text_muted"
            android:textSize="16sp" />

        <Button
            android:id="@+id/closeRationaleButton"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="30dp"
            android:background="@drawable/primary_button_bg"
            android:text="Continue"
            android:textAllCaps="false"
            android:textColor="@color/mood_background_deep"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
